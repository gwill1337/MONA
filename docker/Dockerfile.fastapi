FROM python:3.13-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /app
COPY pyproject.toml uv.lock ./

# --frozen  : не трогать uv.lock, ставить строго как зафиксировано
# --no-default-groups : не тянуть группу dev (она синкается по умолчанию)
# --group docker-fastapi : добавить только нужную для этого образа группу
# --no-install-project : mona_core не оформлен как устанавливаемый пакет,
#                         код копируется просто как файлы ниже
RUN uv sync --frozen --no-default-groups --group docker-fastapi --no-install-project

RUN uv pip install --python /opt/venv/bin/python --no-cache \
    --upgrade "setuptools>=78.1.1" "msgpack>=1.2.1"

FROM python:3.13-slim

RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN addgroup --system --gid 10001 app && adduser --system --uid 10001 --ingroup app app
COPY . /app
WORKDIR /app
RUN chown -R app:app /app
USER app

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health/live', timeout=2)" || exit 1

CMD ["uvicorn", "mona_core.main:app", "--host", "0.0.0.0", "--port", "8080"]
