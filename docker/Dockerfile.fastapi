FROM python:3.13 AS builder

RUN apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY docker/requirements_fastapi.txt .
RUN pip install --no-cache-dir -r requirements_fastapi.txt

FROM python:3.13-slim

RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local /usr/local

RUN pip install --no-cache-dir --upgrade "setuptools>=78.1.1" "msgpack>=1.2.1"

RUN addgroup --system --gid 10001 app && adduser --system --uid 10001 --ingroup app app
COPY . /app
WORKDIR /app
RUN chown -R app:app /app
USER app

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health/live', timeout=2)" || exit 1

CMD ["uvicorn", "mona_core.main:app", "--host", "0.0.0.0", "--port", "8080"]