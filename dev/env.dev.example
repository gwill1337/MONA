# Copy to .env.dev and fill in real values before running docker compose up.
# Log level like ("DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"), "DEBUG" by default
LOG_LEVEL=DEBUG

POSTGRES_USER=myuser123
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mydb

POSTGRES_PORT=5432

ADMIN_USERNAMES=admin
ADMIN_PASSWORDS=admin123
USER_USERNAMES=user1
USER_PASSWORDS=userpass1

CORS_ORIGINS=["http://localhost:30080","http://localhost:5173"]

# Comma-separated jobName:host pairs for physical PCs, e.g. pc-office:10.0.0.8,pc-lab:10.0.0.9
EXPORTERS=