# Copy to .env and fill in real values before running docker compose up.

POSTGRES_USER=myuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mydb

ADMIN_USERNAMES=admin
ADMIN_PASSWORDS=admin123
USER_USERNAMES=
USER_PASSWORDS=

CORS_ORIGINS=["http://localhost:30081"]

# Comma-separated jobName:host pairs for physical PCs, e.g. pc-office:10.0.0.8,pc-lab:10.0.0.9
EXPORTERS=
