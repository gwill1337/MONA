# Copy to .env and fill in real values before running docker compose up.
# Log level like ("DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"), "INFO" by default
LOG_LEVEL=INFO

# Postgres credentials.
POSTGRES_USER=myuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mydb

POSTGRES_PORT=5432

# If filled, it enables external Postgres or Redis.
# For external Postgres (such as Supabase, etc.), an IPv4 address is required.
database_url=
redis_url=

# Passwords and Usernames.
# Example: admin,admin2 and etc. 
ADMIN_USERNAMES=admin
ADMIN_PASSWORDS=admin123
USER_USERNAMES=
USER_PASSWORDS=

# CORS.
CORS_ORIGINS=["http://localhost:30081"]

# Comma-separated jobName:host pairs for physical PCs, e.g. pc-office:10.0.0.8,pc-lab:10.0.0.9
EXPORTERS=
